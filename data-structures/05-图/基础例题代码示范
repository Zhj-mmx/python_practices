# 答案代码
adj_matrix = np.zeros((4, 4), dtype=int)  # 先画一张全是 0 的 4x4 表格

# 根据边来填 1（因为是无向图，A-B 相连意味着 A行B列 和 B行A列 都是 1）
adj_matrix[0, 1] = adj_matrix[1, 0] = 1  # A - B
adj_matrix[0, 2] = adj_matrix[2, 0] = 1  # A - C
adj_matrix[1, 3] = adj_matrix[3, 1] = 1  # B - D
adj_matrix[2, 3] = adj_matrix[3, 2] = 1  # C - D

