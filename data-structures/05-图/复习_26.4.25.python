#重敲一遍代码用来复习图的一些基础知识(26.4.25)



from collections import deque

adj_list = {
    'A': ['B', 'C'],
    'B': ['A', 'D'],
    'C': ['A', 'D'],
    'D': ['B', 'C']
}

def bfs(start): #广度优先遍历
    visited = set()
    queue = deque()

    visited.add(start)
    queue.append(start)

    while queue:
        current = queue.popleft()
        print(current, end=' ')

        for neighbor in adj_list[current]:
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append(neighbor)
                
print("BFS 访问顺序：")
bfs('A', )

visited = set()

def dfs(node):
    visited.add(node)
    print(node, end=' ')

    for neighbor in adj_list[node]:
        if neighbor not in visited:
            dfs(neighbor)
       

print("\nDFS 访问顺序：")
dfs('A')